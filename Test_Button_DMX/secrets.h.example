#pragma once

// AP mode — the device's own access point. Always on.
#define WIFI_SSID "dmx-fire"
#define WIFI_PASS "your-password-here"

// Optional STA mode — also join an existing WiFi (e.g. home/office) so the
// device is reachable from the LAN without leaving that network.
// Leave WIFI_STA_SSID empty ("") to disable.
#define WIFI_STA_SSID ""
#define WIFI_STA_PASS ""
